     "verdict_on_hit": "warn", "verdict_on_miss": "pass",
     "reason_template": "关键事实仅靠截图/聊天转述、无官方文书佐证 → 预警补件(核心原则:被证明≠被说明)。例外:B05 机构IM告知有效。",
     "on_missing_data": "warn", "priority": 30, "tags": ["evidence", "principle"]},

    {"id": "rule_report_fill_advisory", "subject": "报表项/公摊填充建议", "effect": "advisory",
