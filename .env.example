# 资质智能审核助手 - 环境变量配置模板
# 复制此文件为 .env 并填入你自己的配置
#
# ⚠️  首次使用必做：去掉下面 QUAL_AUDIT_ROLE 的注释，设为你的岗位。
#    法人岗(faren) → 审法定代表人签名、营业执照、股东类
#    非法人岗(feifaren) → 审品牌授权书、商标注册证、商标授权书
#    不设 = 首次运行 AI 弹卡片让你选择

FEISHU_APP_ID=<你的飞书应用ID>
QUAL_DEFINITION_CODE=<审批定义code>
FEISHU_USER_OPEN_ID=<审批人open_id>
QUAL_ATTACH_DIR=<附件缓存目录，如 D:\fando-ocr-cache>
LARK_AUDIT_CHAT_ID=<审核结果发卡群chat_id —— 让 AI 设为“你当前这个群”的 chat_id；不设则拒发，绝不误发到别人的群>
QUAL_SOFFICE_BIN=<LibreOffice路径，如 D:\Program\soffice.exe>  # 可选
# QUAL_CARD_SCRIPT 无需配置：代码自动定位 scripts/gen_card_from_json.ps1（除非放到非标准路径才设）
# 🔴 角色（faren=法人岗 / feifaren=非法人岗）：【首次故意留空】→ 首跑 list 会弹卡片让你选岗位、自动写回这里。
#    别在这里预设，否则跳过选岗流程。选好后此处会变成 QUAL_AUDIT_ROLE=faren 或 feifaren。
# QUAL_AUDIT_ROLE=
